{
    "name": "switchwaste/switch-waste-website",
    "description": "Professional waste management website for Switch Waste Solutions",
    "type": "project",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Switch Waste Solutions",
            "email": "info@switchwaste.co.za"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "SwitchWaste\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "prefer-stable": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}