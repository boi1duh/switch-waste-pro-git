# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Application Configuration
REACT_APP_TITLE="Switch Waste Management Solutions"
REACT_APP_DESCRIPTION="Professional waste management services in Johannesburg"
REACT_APP_URL="https://www.switchwaste.co.za"

# API Configuration (if needed)
# REACT_APP_API_BASE_URL="https://api.switchwaste.co.za"
# REACT_APP_API_KEY="your-api-key-here"

# Analytics (Optional)
# REACT_APP_GOOGLE_ANALYTICS_ID="GA_MEASUREMENT_ID"
# REACT_APP_GOOGLE_TAG_MANAGER_ID="GTM-XXXXXXX"

# Social Media (Optional)
# REACT_APP_FACEBOOK_APP_ID="your-facebook-app-id"
# REACT_APP_LINKEDIN_PARTNER_ID="your-linkedin-partner-id"

# Email Service (Optional)
# REACT_APP_EMAILJS_SERVICE_ID="your-emailjs-service-id"
# REACT_APP_EMAILJS_TEMPLATE_ID="your-emailjs-template-id"
# REACT_APP_EMAILJS_USER_ID="your-emailjs-user-id"

# Development
NODE_ENV="development"

# Build Configuration
GENERATE_SOURCEMAP=false
SKIP_PREFLIGHT_CHECK=true