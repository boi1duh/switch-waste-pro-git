{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    ":ignoreUnstable",
    "group:monorepos",
    "group:recommended",
    "workarounds:all"
  ],
  "schedule": ["before 4am on Monday"],
  "timezone": "Africa/Johannesburg",
  "labels": ["dependencies"],
  "assignees": ["@boi1duh"],
  "reviewers": ["@boi1duh"],
  "packageRules": [
    {
      "description": "Group React and React-related packages",
      "groupName": "React packages",
      "matchPackagePatterns": ["^react", "^@types/react"]
    },
    {
      "description": "Group testing packages",
      "groupName": "Testing packages",
      "matchPackagePatterns": ["^@testing-library", "^jest"]
    },
    {
      "description": "Group build tools",
      "groupName": "Build tools",
      "matchPackagePatterns": ["^webpack", "^babel", "^eslint", "^prettier"]
    },
    {
      "description": "Automerge patch updates for dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on Monday"]
  }
}